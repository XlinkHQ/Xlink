# ─────────────────────────────────────────────────────────────
# XLink environment configuration
# Copy to `.env` and adjust. NEVER commit a populated .env file.
# ─────────────────────────────────────────────────────────────

# --- Bootstrap admin ---
# On first boot the panel creates this admin if it does not exist.
# Set both, log in once, then remove the password line (login still works).
XLINK_ADMIN_USERNAME=admin
XLINK_ADMIN_PASSWORD=change_me_admin_password

# --- Application ---
XLINK_ENV=local                       # local | staging | production
XLINK_DEBUG=true
XLINK_PROJECT_NAME=XLink
XLINK_API_V1_PREFIX=/api/v1
XLINK_HOST=0.0.0.0
XLINK_PORT=8000
# The dashboard shows the panel host's IP/MAC. Running in Docker, auto-detection
# picks the container bridge IP (172.x) and a virtual MAC — not the real server.
# Set these to the server's real public IP/MAC to display them correctly.
XLINK_PUBLIC_IP=
XLINK_PUBLIC_MAC=
# Set a domain to enable automatic HTTPS (Caddy edge, Let's Encrypt). Leave blank
# to serve plain ports. Point the domain's A/AAAA record at this server first.
XLINK_DOMAIN=
XLINK_ACME_EMAIL=
# Comma-separated list of allowed CORS origins
XLINK_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated trusted hosts (use * only for local)
XLINK_TRUSTED_HOSTS=*

# --- Logging ---
XLINK_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
XLINK_LOG_JSON=false                   # true for prod (structured JSON logs)

# --- PostgreSQL ---
XLINK_POSTGRES_HOST=localhost
XLINK_POSTGRES_PORT=5432
XLINK_POSTGRES_USER=xlink
XLINK_POSTGRES_PASSWORD=change_me_in_production
XLINK_POSTGRES_DB=xlink
XLINK_DB_POOL_SIZE=20
XLINK_DB_MAX_OVERFLOW=10
XLINK_DB_POOL_TIMEOUT=30
XLINK_DB_POOL_RECYCLE=1800
XLINK_DB_ECHO=false

# --- Optional read replica ---
# Leave BOTH unset to run on a single engine (default; behaviour unchanged).
# When set, heavy read-only analytics + subscription-source reads are routed to
# the replica; all writes and read-after-write flows stay on the primary. A
# replica outage falls back to the primary for those reads. Either give a full
# URL override, or a host (credentials/db/port are reused from the primary).
# XLINK_DATABASE_URL_REPLICA_OVERRIDE=postgresql+asyncpg://xlink:pass@replica:5432/xlink
# XLINK_POSTGRES_REPLICA_HOST=
# XLINK_POSTGRES_REPLICA_PORT=
# XLINK_DB_REPLICA_POOL_SIZE=
# XLINK_DB_REPLICA_MAX_OVERFLOW=

# --- Redis ---
XLINK_REDIS_HOST=localhost
XLINK_REDIS_PORT=6379
XLINK_REDIS_DB=0
XLINK_REDIS_PASSWORD=
XLINK_REDIS_MAX_CONNECTIONS=50
XLINK_CACHE_TTL_SECONDS=300

# --- Security / JWT ---
# Generate with: openssl rand -hex 32
XLINK_JWT_SECRET_KEY=replace_me_with_openssl_rand_hex_32
XLINK_JWT_ALGORITHM=HS256
XLINK_ACCESS_TOKEN_EXPIRE_MINUTES=15
XLINK_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Argon2 password hashing ---
XLINK_ARGON2_TIME_COST=3
XLINK_ARGON2_MEMORY_COST=65536
XLINK_ARGON2_PARALLELISM=4
# Max concurrent password hash/verify operations offloaded to worker threads.
XLINK_PASSWORD_HASH_MAX_WORKERS=8

# --- Rate limiting ---
XLINK_RATE_LIMIT_ENABLED=true
XLINK_RATE_LIMIT_PER_MINUTE=120
XLINK_RATE_LIMIT_FAIL_OPEN=true
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For
XLINK_TRUSTED_PROXY_IPS=

# --- Pagination ---
XLINK_DEFAULT_PAGE_SIZE=20
XLINK_MAX_PAGE_SIZE=100

# --- Background jobs ---
# Periodic purge of expired refresh tokens.
XLINK_TOKEN_CLEANUP_ENABLED=true
XLINK_TOKEN_CLEANUP_INTERVAL_SECONDS=3600

# --- Prometheus metrics exporter (optional, OFF by default) ---
# Exposes GET /metrics in Prometheus text format for external scraping:
# process/runtime metrics, HTTP request count + latency histogram (labeled by
# method + route template + status), and domain gauges (users/nodes/traffic).
# This is SEPARATE from the internal agent /metrics ingest and the admin
# /api/v1/monitoring summary.
#
# Off by default: leave XLINK_METRICS_TOKEN unset and GET /metrics returns 404.
# Set a strong random secret to enable it; the scraper must then present
# `Authorization: Bearer <token>`. The domain-gauge background collector only
# runs when the token is set. Example scrape_config for prometheus.yml:
#
#   - job_name: xlink
#     bearer_token: "<same value as XLINK_METRICS_TOKEN>"
#     static_configs:
#       - targets: ["panel-host:8000"]
#
# Do NOT expose /metrics publicly without a token; keep it network-restricted.
XLINK_METRICS_TOKEN=

# --- Standalone subscription page (optional, off by default) ---
# A separate public service that serves /sub/{token} links WITHOUT exposing the
# panel's domain, so the panel API can be IP-restricted. Enable with the
# "subpage" compose profile:  docker compose --profile subpage up -d
# Point your sub-page domain at SUB_PAGE_PORT (or a TLS edge in front of it) and
# set SUB_PAGE_PUBLIC_HOST so the panel advertises links on the sub-page domain.
SUB_PAGE_PORT=8081
SUB_PAGE_PUBLIC_HOST=              # e.g. sub.example.com
SUB_PAGE_PUBLIC_PROTO=https
SUB_PAGE_PANEL_URL=http://api:8000 # internal panel URL on the compose network
SUB_PAGE_PANEL_API_TOKEN=          # optional shared secret (see subscription-page/README.md)
# For the real client IP (device-limit / HWID) to survive the extra hop, the
# panel must trust the sub-page container as a proxy. Set this to the compose
# network CIDR (or the sub-page container IP). Defaults to 127.0.0.1 (current
# behaviour) when unset. See subscription-page/README.md.
XLINK_FORWARDED_ALLOW_IPS=127.0.0.1
